{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "destination": "https://www.cubicyardhub.com/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubicyardhub.com"
        }
      ],
      "permanent": true,
      "source": "/:path*.html"
    },
    {
      "destination": "https://www.cubicyardhub.com/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubicyardhub.com"
        }
      ],
      "permanent": true,
      "source": "/:path*/"
    },
    {
      "destination": "https://www.cubicyardhub.com/:path*",
      "has": [
        {
          "type": "host",
          "value": "cubicyardhub.com"
        }
      ],
      "permanent": true,
      "source": "/:path*"
    },
    {
      "source": "/:slug*.html",
      "destination": "/:slug*",
      "permanent": true
    },
    {
      "source": "/materials/dirt-calculator",
      "destination": "/dirt-calculator",
      "permanent": true
    },
    {
      "source": "/materials/mulch-calculator",
      "destination": "/mulch-calculator",
      "permanent": true
    },
    {
      "source": "/materials/sand-calculator",
      "destination": "/sand-calculator",
      "permanent": true
    },
    {
      "source": "/converters/yards-to-tons-calculator",
      "destination": "/yards-to-tons",
      "permanent": true
    }
  ]
}
