{
  "": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)\\.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/materials/dirt-calculator",
      "destination": "/dirt-calculator",
      "permanent": true
    },
    {
      "source": "/materials/mulch-calculator",
      "destination": "/mulch-calculator",
      "permanent": true
    },
    {
      "source": "/materials/sand-calculator",
      "destination": "/sand-calculator",
      "permanent": true
    },
    {
      "source": "/converters/yards-to-tons-calculator",
      "destination": "/yards-to-tons",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}